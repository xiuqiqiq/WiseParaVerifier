MurphiProtocol((MurphiConst(QUORUMNUMS, 2), MurphiConst(VALUENUMS, 2), MurphiConst(NODENUMS, 2)), (MurphiTypeDecl('quorum', ScalarSetType(QUORUMNUMS)), MurphiTypeDecl('node', ScalarSetType(NODENUMS)), MurphiTypeDecl('value', ScalarSetType(VALUENUMS))), (MurphiVarDecl('member', ArrayType(VarType(node), ArrayType(VarType(quorum), BooleanType()))), MurphiVarDecl('voted', ArrayType(VarType(node), BooleanType())), MurphiVarDecl('vote', ArrayType(VarType(node), ArrayType(VarType(value), BooleanType()))), MurphiVarDecl('decided', ArrayType(VarType(value), BooleanType()))), RulesetStartState((MurphiVarDecl('n', VarType(node)),), StartState('Init', [AssignCmd(ArrayIndex(VarExpr('voted'), VarExpr('n')), BooleanExpr(False)), ForallCmd(MurphiVarDecl('v', VarType(value)), [AssignCmd(ArrayIndex(ArrayIndex(VarExpr('vote'), VarExpr('n')), VarExpr('v')), BooleanExpr(False)), AssignCmd(ArrayIndex(VarExpr('decided'), VarExpr('v')), BooleanExpr(False))])])), [MurphiRuleSet((MurphiVarDecl('n', VarType(node)), MurphiVarDecl('v', VarType(value))), MurphiRule('cast_vote', OpExpr(=, voted[n], false), [AssignCmd(ArrayIndex(ArrayIndex(VarExpr('vote'), VarExpr('n')), VarExpr('v')), BooleanExpr(True)), AssignCmd(ArrayIndex(VarExpr('voted'), VarExpr('n')), BooleanExpr(True))])), MurphiRuleSet((MurphiVarDecl('v', VarType(value)), MurphiVarDecl('q', VarType(quorum))), MurphiRule('decide', ForallExpr(MurphiVarDecl('N', VarType(node)), OpExpr(->, member[N][q] = true, vote[N][v] = true)), [AssignCmd(ArrayIndex(VarExpr('decided'), VarExpr('v')), BooleanExpr(True))])), Invariant('toyConsensusEpr', ForallExpr(MurphiVarDecl('V1', VarType(value)), ForallExpr(MurphiVarDecl('V2', VarType(value)), OpExpr(->, V1 != V2, !(decided[V1] = true & decided[V2] = true)))))])
