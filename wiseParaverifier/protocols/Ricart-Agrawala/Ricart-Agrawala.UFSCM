MurphiProtocol((MurphiConst(NODENUMS, 2),), (MurphiTypeDecl('NODE', ScalarSetType(NODENUMS)),), (MurphiVarDecl('requested', ArrayType(VarType(NODE), ArrayType(VarType(NODE), BooleanType()))), MurphiVarDecl('replied', ArrayType(VarType(NODE), ArrayType(VarType(NODE), BooleanType()))), MurphiVarDecl('holds', ArrayType(VarType(NODE), BooleanType()))), RulesetStartState((MurphiVarDecl('i', VarType(NODE)),), StartState('Init', [AssignCmd(ArrayIndex(VarExpr('holds'), VarExpr('i')), BooleanExpr(False)), ForallCmd(MurphiVarDecl('h', VarType(NODE)), [AssignCmd(ArrayIndex(ArrayIndex(VarExpr('requested'), VarExpr('i')), VarExpr('h')), BooleanExpr(False)), AssignCmd(ArrayIndex(ArrayIndex(VarExpr('replied'), VarExpr('i')), VarExpr('h')), BooleanExpr(False))])])), [MurphiRuleSet((MurphiVarDecl('requester', VarType(NODE)), MurphiVarDecl('responder', VarType(NODE))), MurphiRule('request', OpExpr(&, requester != responder, requested[requester][responder] = false), [AssignCmd(ArrayIndex(ArrayIndex(VarExpr('requested'), VarExpr('requester')), VarExpr('responder')), BooleanExpr(True))])), MurphiRuleSet((MurphiVarDecl('requester', VarType(NODE)), MurphiVarDecl('responder', VarType(NODE))), MurphiRule('reply', OpExpr(&, requester != responder, replied[requester][responder] = false & holds[responder] = false & replied[responder][requester] = false & requested[requester][responder] = true), [AssignCmd(ArrayIndex(ArrayIndex(VarExpr('requested'), VarExpr('requester')), VarExpr('responder')), BooleanExpr(False)), AssignCmd(ArrayIndex(ArrayIndex(VarExpr('replied'), VarExpr('requester')), VarExpr('responder')), BooleanExpr(True))])), MurphiRuleSet((MurphiVarDecl('requester', VarType(NODE)),), MurphiRule('enter', ForallExpr(MurphiVarDecl('n', VarType(NODE)), OpExpr(->, requester != n, replied[requester][n] = true)), [AssignCmd(ArrayIndex(VarExpr('holds'), VarExpr('requester')), BooleanExpr(True))])), MurphiRuleSet((MurphiVarDecl('requester', VarType(NODE)),), MurphiRule('leave', OpExpr(=, holds[requester], true), [AssignCmd(ArrayIndex(VarExpr('holds'), VarExpr('requester')), BooleanExpr(False)), ForallCmd(MurphiVarDecl('n', VarType(NODE)), [AssignCmd(ArrayIndex(ArrayIndex(VarExpr('replied'), VarExpr('requester')), VarExpr('n')), BooleanExpr(False))])])), Invariant('Oneholds', ForallExpr(MurphiVarDecl('i', VarType(NODE)), ForallExpr(MurphiVarDecl('j', VarType(NODE)), OpExpr(->, i != j, !(holds[i] = true & holds[j] = true)))))])
