MurphiProtocol((MurphiConst(KEYNUMS, 1), MurphiConst(VALUENUMS, 2), MurphiConst(NODENUMS, 2)), (MurphiTypeDecl('key', ScalarSetType(KEYNUMS)), MurphiTypeDecl('value', ScalarSetType(VALUENUMS)), MurphiTypeDecl('node', ScalarSetType(NODENUMS)), MurphiTypeDecl('table_idx', ArrayType(VarType(value), BooleanType())), MurphiTypeDecl('table_idx_idx', ArrayType(VarType(key), VarType(table_idx))), MurphiTypeDecl('owner_idx', ArrayType(VarType(key), BooleanType())), MurphiTypeDecl('transfer_msg_idx', ArrayType(VarType(value), BooleanType())), MurphiTypeDecl('transfer_msg_idx_idx', ArrayType(VarType(key), VarType(transfer_msg_idx)))), (MurphiVarDecl('table', ArrayType(VarType(node), VarType(table_idx_idx))), MurphiVarDecl('owner', ArrayType(VarType(node), VarType(owner_idx))), MurphiVarDecl('transfer_msg', ArrayType(VarType(node), VarType(transfer_msg_idx_idx)))), RulesetStartState((MurphiVarDecl('k', VarType(key)), MurphiVarDecl('n1', VarType(node))), StartState('Init', [ForallCmd(MurphiVarDecl('v', VarType(value)), [AssignCmd(ArrayIndex(ArrayIndex(ArrayIndex(VarExpr('table'), VarExpr('n1')), VarExpr('k')), VarExpr('v')), BooleanExpr(False)), AssignCmd(ArrayIndex(ArrayIndex(ArrayIndex(VarExpr('transfer_msg'), VarExpr('n1')), VarExpr('k')), VarExpr('v')), BooleanExpr(False))]), AssignCmd(ArrayIndex(ArrayIndex(VarExpr('owner'), VarExpr('n1')), VarExpr('k')), BooleanExpr(False))])), [MurphiRuleSet((MurphiVarDecl('k', VarType(key)), MurphiVarDecl('v', VarType(value)), MurphiVarDecl('n_old', VarType(node)), MurphiVarDecl('n_new', VarType(node))), MurphiRule('reshard', OpExpr(=, table[n_old][k][v], true), [AssignCmd(ArrayIndex(ArrayIndex(ArrayIndex(VarExpr('table'), VarExpr('n_old')), VarExpr('k')), VarExpr('v')), BooleanExpr(False)), AssignCmd(ArrayIndex(ArrayIndex(VarExpr('owner'), VarExpr('n_old')), VarExpr('k')), BooleanExpr(False)), AssignCmd(ArrayIndex(ArrayIndex(ArrayIndex(VarExpr('transfer_msg'), VarExpr('n_new')), VarExpr('k')), VarExpr('v')), BooleanExpr(True))])), MurphiRuleSet((MurphiVarDecl('n', VarType(node)), MurphiVarDecl('k', VarType(key)), MurphiVarDecl('v', VarType(value))), MurphiRule('recv_transfer_msg', OpExpr(=, transfer_msg[n][k][v], true), [AssignCmd(ArrayIndex(ArrayIndex(ArrayIndex(VarExpr('transfer_msg'), VarExpr('n')), VarExpr('k')), VarExpr('v')), BooleanExpr(False)), AssignCmd(ArrayIndex(ArrayIndex(ArrayIndex(VarExpr('table'), VarExpr('n')), VarExpr('k')), VarExpr('v')), BooleanExpr(True)), AssignCmd(ArrayIndex(ArrayIndex(VarExpr('owner'), VarExpr('n')), VarExpr('k')), BooleanExpr(True))])), MurphiRuleSet((MurphiVarDecl('n', VarType(node)), MurphiVarDecl('k', VarType(key)), MurphiVarDecl('v', VarType(value))), MurphiRule('put', OpExpr(=, owner[n][k], true), [ForallCmd(MurphiVarDecl('p', VarType(value)), [IfCmd([OpExpr(=, p, v), [AssignCmd(ArrayIndex(ArrayIndex(ArrayIndex(VarExpr('table'), VarExpr('n')), VarExpr('k')), VarExpr('p')), BooleanExpr(True))], [AssignCmd(ArrayIndex(ArrayIndex(ArrayIndex(VarExpr('table'), VarExpr('n')), VarExpr('k')), VarExpr('p')), BooleanExpr(False))]])])])), Invariant('OnenodeValue', ForallExpr(MurphiVarDecl('n1', VarType(node)), ForallExpr(MurphiVarDecl('n2', VarType(node)), ForallExpr(MurphiVarDecl('v1', VarType(value)), ForallExpr(MurphiVarDecl('v2', VarType(value)), ForallExpr(MurphiVarDecl('k', VarType(key)), OpExpr(->, n1 != n2 & v1 != v2, !(table[n1][k][v1] = true & table[n2][k][v2] = true))))))))])
