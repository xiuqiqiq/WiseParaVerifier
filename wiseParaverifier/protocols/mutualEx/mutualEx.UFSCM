MurphiProtocol((MurphiConst(NODENUMS, 2),), (MurphiTypeDecl('state', EnumType('i_em', 't_em', 'c_em', 'e_em')), MurphiTypeDecl('NODE', ScalarSetType(NODENUMS))), (MurphiVarDecl('n', ArrayType(VarType(NODE), VarType(state))), MurphiVarDecl('x', BooleanType())), StartState('Init', [ForallCmd(MurphiVarDecl('i', VarType(NODE)), [AssignCmd(ArrayIndex(VarExpr('n'), VarExpr('i')), EnumValExpr(EnumType('i_em', 't_em', 'c_em', 'e_em'), 'i_em'))]), AssignCmd(VarExpr('x'), BooleanExpr(True))]), [MurphiRuleSet((MurphiVarDecl('i', VarType(NODE)),), MurphiRule('Try', OpExpr(=, n[i], i_em), [AssignCmd(ArrayIndex(VarExpr('n'), VarExpr('i')), EnumValExpr(EnumType('i_em', 't_em', 'c_em', 'e_em'), 't_em'))])), MurphiRuleSet((MurphiVarDecl('i', VarType(NODE)),), MurphiRule('Crit', OpExpr(&, n[i] = t_em, x = true), [AssignCmd(ArrayIndex(VarExpr('n'), VarExpr('i')), EnumValExpr(EnumType('i_em', 't_em', 'c_em', 'e_em'), 'c_em')), AssignCmd(VarExpr('x'), BooleanExpr(False))])), MurphiRuleSet((MurphiVarDecl('i', VarType(NODE)),), MurphiRule('Exit', OpExpr(=, n[i], c_em), [AssignCmd(ArrayIndex(VarExpr('n'), VarExpr('i')), EnumValExpr(EnumType('i_em', 't_em', 'c_em', 'e_em'), 'e_em'))])), MurphiRuleSet((MurphiVarDecl('i', VarType(NODE)),), MurphiRule('Idle', OpExpr(=, n[i], e_em), [AssignCmd(ArrayIndex(VarExpr('n'), VarExpr('i')), EnumValExpr(EnumType('i_em', 't_em', 'c_em', 'e_em'), 'i_em')), AssignCmd(VarExpr('x'), BooleanExpr(True))])), Invariant('mutualEx', ForallExpr(MurphiVarDecl('i', VarType(NODE)), ForallExpr(MurphiVarDecl('j', VarType(NODE)), OpExpr(->, i != j, !(n[i] = c_em & n[j] = c_em)))))])
