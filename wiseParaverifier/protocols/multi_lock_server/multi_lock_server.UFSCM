MurphiProtocol((MurphiConst(NODENUMS, 2), MurphiConst(LOCKNUMS, 1)), (MurphiTypeDecl('node', ScalarSetType(NODENUMS)), MurphiTypeDecl('lock', ScalarSetType(LOCKNUMS))), (MurphiVarDecl('lock_msg', ArrayType(VarType(node), ArrayType(VarType(lock), BooleanType()))), MurphiVarDecl('grant_msg', ArrayType(VarType(node), ArrayType(VarType(lock), BooleanType()))), MurphiVarDecl('unlock_msg', ArrayType(VarType(node), ArrayType(VarType(lock), BooleanType()))), MurphiVarDecl('holds_lock', ArrayType(VarType(node), ArrayType(VarType(lock), BooleanType()))), MurphiVarDecl('server_holds_lock', ArrayType(VarType(lock), BooleanType()))), RulesetStartState((MurphiVarDecl('l', VarType(lock)),), StartState('Init', [ForallCmd(MurphiVarDecl('n', VarType(node)), [AssignCmd(ArrayIndex(ArrayIndex(VarExpr('lock_msg'), VarExpr('n')), VarExpr('l')), BooleanExpr(False)), AssignCmd(ArrayIndex(ArrayIndex(VarExpr('grant_msg'), VarExpr('n')), VarExpr('l')), BooleanExpr(False)), AssignCmd(ArrayIndex(ArrayIndex(VarExpr('unlock_msg'), VarExpr('n')), VarExpr('l')), BooleanExpr(False)), AssignCmd(ArrayIndex(ArrayIndex(VarExpr('holds_lock'), VarExpr('n')), VarExpr('l')), BooleanExpr(False)), AssignCmd(ArrayIndex(VarExpr('server_holds_lock'), VarExpr('l')), BooleanExpr(True))])])), [MurphiRuleSet((MurphiVarDecl('n', VarType(node)), MurphiVarDecl('l', VarType(lock))), MurphiRule('send_lock', BooleanExpr(True), [AssignCmd(ArrayIndex(ArrayIndex(VarExpr('lock_msg'), VarExpr('n')), VarExpr('l')), BooleanExpr(True))])), MurphiRuleSet((MurphiVarDecl('n', VarType(node)), MurphiVarDecl('l', VarType(lock))), MurphiRule('recv_lock', OpExpr(&, lock_msg[n][l] = true, server_holds_lock[l] = true), [AssignCmd(ArrayIndex(VarExpr('server_holds_lock'), VarExpr('l')), BooleanExpr(False)), AssignCmd(ArrayIndex(ArrayIndex(VarExpr('lock_msg'), VarExpr('n')), VarExpr('l')), BooleanExpr(False)), AssignCmd(ArrayIndex(ArrayIndex(VarExpr('grant_msg'), VarExpr('n')), VarExpr('l')), BooleanExpr(True))])), MurphiRuleSet((MurphiVarDecl('n', VarType(node)), MurphiVarDecl('l', VarType(lock))), MurphiRule('recv_grant', OpExpr(=, grant_msg[n][l], true), [AssignCmd(ArrayIndex(ArrayIndex(VarExpr('grant_msg'), VarExpr('n')), VarExpr('l')), BooleanExpr(False)), AssignCmd(ArrayIndex(ArrayIndex(VarExpr('holds_lock'), VarExpr('n')), VarExpr('l')), BooleanExpr(True))])), MurphiRuleSet((MurphiVarDecl('n', VarType(node)), MurphiVarDecl('l', VarType(lock))), MurphiRule('unlock', OpExpr(=, holds_lock[n][l], true), [AssignCmd(ArrayIndex(ArrayIndex(VarExpr('holds_lock'), VarExpr('n')), VarExpr('l')), BooleanExpr(False)), AssignCmd(ArrayIndex(ArrayIndex(VarExpr('unlock_msg'), VarExpr('n')), VarExpr('l')), BooleanExpr(True))])), MurphiRuleSet((MurphiVarDecl('n', VarType(node)), MurphiVarDecl('l', VarType(lock))), MurphiRule('recv_unlock', OpExpr(=, unlock_msg[n][l], true), [AssignCmd(ArrayIndex(ArrayIndex(VarExpr('unlock_msg'), VarExpr('n')), VarExpr('l')), BooleanExpr(False)), AssignCmd(ArrayIndex(VarExpr('server_holds_lock'), VarExpr('l')), BooleanExpr(True))])), Invariant('Onelink', ForallExpr(MurphiVarDecl('n1', VarType(node)), ForallExpr(MurphiVarDecl('n2', VarType(node)), ForallExpr(MurphiVarDecl('l', VarType(lock)), OpExpr(->, n1 != n2, !(holds_lock[n1][l] = true & holds_lock[n2][l] = true))))))])
