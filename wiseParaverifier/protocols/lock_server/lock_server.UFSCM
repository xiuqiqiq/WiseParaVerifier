MurphiProtocol((MurphiConst(SERNUMS, 1), MurphiConst(CLINUMS, 2)), (MurphiTypeDecl('client', ScalarSetType(CLINUMS)), MurphiTypeDecl('server', ScalarSetType(SERNUMS)), MurphiTypeDecl('link_idx', ArrayType(VarType(server), BooleanType()))), (MurphiVarDecl('link', ArrayType(VarType(client), VarType(link_idx))), MurphiVarDecl('semaphore', ArrayType(VarType(server), BooleanType()))), RulesetStartState((MurphiVarDecl('i', VarType(client)),), StartState('Init', [ForallCmd(MurphiVarDecl('h', VarType(server)), [AssignCmd(ArrayIndex(VarExpr('semaphore'), VarExpr('h')), BooleanExpr(True)), AssignCmd(ArrayIndex(ArrayIndex(VarExpr('link'), VarExpr('i')), VarExpr('h')), BooleanExpr(False))])])), [MurphiRuleSet((MurphiVarDecl('x', VarType(client)), MurphiVarDecl('y', VarType(server))), MurphiRule('connect', OpExpr(=, semaphore[y], true), [AssignCmd(ArrayIndex(ArrayIndex(VarExpr('link'), VarExpr('x')), VarExpr('y')), BooleanExpr(True)), AssignCmd(ArrayIndex(VarExpr('semaphore'), VarExpr('y')), BooleanExpr(False))])), MurphiRuleSet((MurphiVarDecl('x', VarType(client)), MurphiVarDecl('y', VarType(server))), MurphiRule('disconnect', OpExpr(=, link[x][y], true), [AssignCmd(ArrayIndex(ArrayIndex(VarExpr('link'), VarExpr('x')), VarExpr('y')), BooleanExpr(False)), AssignCmd(ArrayIndex(VarExpr('semaphore'), VarExpr('y')), BooleanExpr(True))])), Invariant('Onelink', ForallExpr(MurphiVarDecl('i', VarType(client)), ForallExpr(MurphiVarDecl('j', VarType(client)), ForallExpr(MurphiVarDecl('k', VarType(server)), OpExpr(->, i != j, !(link[i][k] = true & link[j][k] = true))))))])
