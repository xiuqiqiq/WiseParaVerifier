MurphiProtocol((MurphiConst(NODENUMS, 2), MurphiConst(DATANUMS, 2)), (MurphiTypeDecl('state', EnumType('i_em', 't_em', 'c_em', 'e_em')), MurphiTypeDecl('DATA', ScalarSetType(DATANUMS)), MurphiTypeDecl('NODE', ScalarSetType(NODENUMS)), MurphiTypeDecl('status', RecordType(MurphiTypeDecl('st', VarType(state)), MurphiTypeDecl('data', VarType(DATA))))), (MurphiVarDecl('n', ArrayType(VarType(NODE), VarType(status))), MurphiVarDecl('x', BooleanType()), MurphiVarDecl('auxDATA', VarType(DATA)), MurphiVarDecl('memDATA', VarType(DATA))), RulesetStartState((MurphiVarDecl('d', VarType(DATA)),), StartState('Init', [ForallCmd(MurphiVarDecl('i', VarType(NODE)), [AssignCmd(FieldName(ArrayIndex(VarExpr('n'), VarExpr('i')), Token('CNAME', 'st')), EnumValExpr(EnumType('i_em', 't_em', 'c_em', 'e_em'), 'i_em')), AssignCmd(FieldName(ArrayIndex(VarExpr('n'), VarExpr('i')), Token('CNAME', 'data')), VarExpr('d'))]), AssignCmd(VarExpr('x'), BooleanExpr(True)), AssignCmd(VarExpr('auxDATA'), VarExpr('d')), AssignCmd(VarExpr('memDATA'), VarExpr('d'))])), [MurphiRuleSet((MurphiVarDecl('i', VarType(NODE)),), MurphiRule('Try', OpExpr(=, n[i].st, i_em), [AssignCmd(FieldName(ArrayIndex(VarExpr('n'), VarExpr('i')), Token('CNAME', 'st')), EnumValExpr(EnumType('i_em', 't_em', 'c_em', 'e_em'), 't_em'))])), MurphiRuleSet((MurphiVarDecl('i', VarType(NODE)),), MurphiRule('Crit', OpExpr(&, n[i].st = t_em, x = true), [AssignCmd(FieldName(ArrayIndex(VarExpr('n'), VarExpr('i')), Token('CNAME', 'st')), EnumValExpr(EnumType('i_em', 't_em', 'c_em', 'e_em'), 'c_em')), AssignCmd(VarExpr('x'), BooleanExpr(False)), AssignCmd(FieldName(ArrayIndex(VarExpr('n'), VarExpr('i')), Token('CNAME', 'data')), VarExpr('memDATA'))])), MurphiRuleSet((MurphiVarDecl('i', VarType(NODE)),), MurphiRule('Exit', OpExpr(=, n[i].st, c_em), [AssignCmd(FieldName(ArrayIndex(VarExpr('n'), VarExpr('i')), Token('CNAME', 'st')), EnumValExpr(EnumType('i_em', 't_em', 'c_em', 'e_em'), 'e_em'))])), MurphiRuleSet((MurphiVarDecl('i', VarType(NODE)),), MurphiRule('Idle', OpExpr(=, n[i].st, e_em), [AssignCmd(FieldName(ArrayIndex(VarExpr('n'), VarExpr('i')), Token('CNAME', 'st')), EnumValExpr(EnumType('i_em', 't_em', 'c_em', 'e_em'), 'i_em')), AssignCmd(VarExpr('x'), BooleanExpr(True)), AssignCmd(VarExpr('memDATA'), FieldName(ArrayIndex(VarExpr('n'), VarExpr('i')), Token('CNAME', 'data')))])), MurphiRuleSet((MurphiVarDecl('i', VarType(NODE)), MurphiVarDecl('d', VarType(DATA))), MurphiRule('Store', OpExpr(=, n[i].st, c_em), [AssignCmd(VarExpr('auxDATA'), VarExpr('d')), AssignCmd(FieldName(ArrayIndex(VarExpr('n'), VarExpr('i')), Token('CNAME', 'data')), VarExpr('d'))])), Invariant('coherence', ForallExpr(MurphiVarDecl('i', VarType(NODE)), ForallExpr(MurphiVarDecl('j', VarType(NODE)), OpExpr(->, i != j, !(n[i].st = c_em & n[j].st = c_em))))), Invariant('c51', ForallExpr(MurphiVarDecl('i', VarType(NODE)), NegExpr(n[i].st = c_em & n[i].data != auxDATA)))])
