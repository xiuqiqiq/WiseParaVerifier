MurphiProtocol((MurphiConst(NODENUMS, 4),), (MurphiTypeDecl('NODE', ScalarSetType(NODENUMS)), MurphiTypeDecl('message_idx', ArrayType(VarType(NODE), BooleanType()))), (MurphiVarDecl('message', ArrayType(VarType(NODE), ArrayType(VarType(NODE), BooleanType()))), MurphiVarDecl('has_lock', ArrayType(VarType(NODE), BooleanType())), MurphiVarDecl('start_node', VarType(NODE))), RulesetStartState((MurphiVarDecl('h', VarType(NODE)),), StartState('Init', [ForallCmd(MurphiVarDecl('i', VarType(NODE)), [AssignCmd(VarExpr('start_node'), VarExpr('i')), AssignCmd(ArrayIndex(ArrayIndex(VarExpr('message'), VarExpr('i')), VarExpr('h')), BooleanExpr(False)), AssignCmd(ArrayIndex(VarExpr('has_lock'), VarExpr('h')), OpExpr(=, h, start_node))])])), [MurphiRuleSet((MurphiVarDecl('src', VarType(NODE)), MurphiVarDecl('dst', VarType(NODE))), MurphiRule('send', OpExpr(=, has_lock[src], true), [AssignCmd(ArrayIndex(ArrayIndex(VarExpr('message'), VarExpr('src')), VarExpr('dst')), BooleanExpr(True)), AssignCmd(ArrayIndex(VarExpr('has_lock'), VarExpr('src')), BooleanExpr(False))])), MurphiRuleSet((MurphiVarDecl('src', VarType(NODE)), MurphiVarDecl('dst', VarType(NODE))), MurphiRule('recv', OpExpr(=, message[src][dst], true), [AssignCmd(ArrayIndex(ArrayIndex(VarExpr('message'), VarExpr('src')), VarExpr('dst')), BooleanExpr(False)), AssignCmd(ArrayIndex(VarExpr('has_lock'), VarExpr('dst')), BooleanExpr(True))])), Invariant('Onelock', ForallExpr(MurphiVarDecl('i', VarType(NODE)), ForallExpr(MurphiVarDecl('j', VarType(NODE)), OpExpr(->, i != j, !(has_lock[i] = true & has_lock[j] = true)))))])
