    end
end)))), Invariant('coherence', ForallExpr(MurphiVarDecl('i', VarType(nodeType)), ForallExpr(MurphiVarDecl('c', VarType(cacheType)), ForallExpr(MurphiVarDecl('a', VarType(addrType)), OpExpr(->, n[i][c].state = c_em, n[i][c].data = auxData[a] & n[i][c].mark = a)))))])
