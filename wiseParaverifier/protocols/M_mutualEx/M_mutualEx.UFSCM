MurphiProtocol((MurphiConst(NODE_NUM, 2), MurphiConst(Cache_NUM, 2), MurphiConst(Addr_NUM, 4), MurphiConst(Data_NUM, 2), MurphiConst(addrNum, 4), MurphiConst(cacheNum, 2)), (MurphiTypeDecl('nodeType', ScalarSetType(NODE_NUM)), MurphiTypeDecl('dataType', ScalarSetType(Data_NUM)), MurphiTypeDecl('addrType', ScalarSetType(addrNum)), MurphiTypeDecl('stateType', EnumType('i_em', 't_em', 'c_em', 'e_em')), MurphiTypeDecl('cacheType', ScalarSetType(cacheNum)), MurphiTypeDecl('cacheState', RecordType(MurphiTypeDecl('state', VarType(stateType)), MurphiTypeDecl('mark', VarType(addrType)), MurphiTypeDecl('data', VarType(dataType))))), (MurphiVarDecl('n', ArrayType(VarType(nodeType), ArrayType(VarType(cacheType), VarType(cacheState)))), MurphiVarDecl('x', ArrayType(VarType(addrType), BooleanType())), MurphiVarDecl('memData', ArrayType(VarType(addrType), VarType(dataType))), MurphiVarDecl('auxData', ArrayType(VarType(addrType), VarType(dataType)))), RulesetStartState((MurphiVarDecl('c', VarType(cacheType)),), StartState('Init', [ForallCmd(MurphiVarDecl('i', VarType(nodeType)), [AssignCmd(FieldName(ArrayIndex(ArrayIndex(VarExpr('n'), VarExpr('i')), VarExpr('c')), Token('CNAME', 'state')), EnumValExpr(EnumType('i_em', 't_em', 'c_em', 'e_em'), 'i_em'))]), ForallCmd(MurphiVarDecl('a', VarType(addrType)), [AssignCmd(ArrayIndex(VarExpr('x'), VarExpr('a')), BooleanExpr(True))])])), [MurphiRuleSet((MurphiVarDecl('i', VarType(nodeType)), MurphiVarDecl('c', VarType(cacheType)), MurphiVarDecl('d', VarType(dataType)), MurphiVarDecl('a', VarType(addrType))), MurphiRule('Store', OpExpr(&, n[i][c].state = c_em, n[i][c].mark = a), [AssignCmd(FieldName(ArrayIndex(ArrayIndex(VarExpr('n'), VarExpr('i')), VarExpr('c')), Token('CNAME', 'data')), VarExpr('d')), AssignCmd(ArrayIndex(VarExpr('auxData'), VarExpr('a')), VarExpr('d'))])), MurphiRuleSet((MurphiVarDecl('i', VarType(nodeType)), MurphiVarDecl('c', VarType(cacheType))), MurphiRule('Try', OpExpr(=, n[i][c].state, i_em), [AssignCmd(FieldName(ArrayIndex(ArrayIndex(VarExpr('n'), VarExpr('i')), VarExpr('c')), Token('CNAME', 'state')), EnumValExpr(EnumType('i_em', 't_em', 'c_em', 'e_em'), 't_em'))])), MurphiRuleSet((MurphiVarDecl('i', VarType(nodeType)), MurphiVarDecl('c', VarType(cacheType)), MurphiVarDecl('a', VarType(addrType))), MurphiRule('Crit', OpExpr(&, n[i][c].state = t_em, x[a] = true), [AssignCmd(FieldName(ArrayIndex(ArrayIndex(VarExpr('n'), VarExpr('i')), VarExpr('c')), Token('CNAME', 'state')), EnumValExpr(EnumType('i_em', 't_em', 'c_em', 'e_em'), 'c_em')), AssignCmd(FieldName(ArrayIndex(ArrayIndex(VarExpr('n'), VarExpr('i')), VarExpr('c')), Token('CNAME', 'mark')), VarExpr('a')), AssignCmd(FieldName(ArrayIndex(ArrayIndex(VarExpr('n'), VarExpr('i')), VarExpr('c')), Token('CNAME', 'data')), ArrayIndex(VarExpr('memData'), VarExpr('a'))), AssignCmd(ArrayIndex(VarExpr('x'), VarExpr('a')), BooleanExpr(False))])), MurphiRuleSet((MurphiVarDecl('i', VarType(nodeType)), MurphiVarDecl('c', VarType(cacheType))), MurphiRule('Exit', OpExpr(=, n[i][c].state, c_em), [AssignCmd(FieldName(ArrayIndex(ArrayIndex(VarExpr('n'), VarExpr('i')), VarExpr('c')), Token('CNAME', 'state')), EnumValExpr(EnumType('i_em', 't_em', 'c_em', 'e_em'), 'e_em'))])), MurphiRuleSet((MurphiVarDecl('i', VarType(nodeType)), MurphiVarDecl('c', VarType(cacheType)), MurphiVarDecl('a', VarType(addrType))), MurphiRule('Idle', OpExpr(&, n[i][c].state = e_em, n[i][c].mark = a), [AssignCmd(FieldName(ArrayIndex(ArrayIndex(VarExpr('n'), VarExpr('i')), VarExpr('c')), Token('CNAME', 'state')), EnumValExpr(EnumType('i_em', 't_em', 'c_em', 'e_em'), 'i_em')), AssignCmd(ArrayIndex(VarExpr('x'), VarExpr('a')), BooleanExpr(True)), AssignCmd(ArrayIndex(VarExpr('memData'), VarExpr('a')), FieldName(ArrayIndex(ArrayIndex(VarExpr('n'), VarExpr('i')), VarExpr('c')), Token('CNAME', 'data')))])), Invariant('mutualEx', ForallExpr(MurphiVarDecl('i', VarType(nodeType)), ForallExpr(MurphiVarDecl('j', VarType(nodeType)), OpExpr(->, i != j, forall c1 : cacheType do
