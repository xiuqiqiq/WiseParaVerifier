MurphiProtocol((MurphiConst(NODENUMS, 2), MurphiConst(RESPONSENUM, 2), MurphiConst(REQUESTNUM, 2)), (MurphiTypeDecl('node', ScalarSetType(NODENUMS)), MurphiTypeDecl('response', ScalarSetType(RESPONSENUM)), MurphiTypeDecl('request', ScalarSetType(REQUESTNUM))), (MurphiVarDecl('match', ArrayType(VarType(request), ArrayType(VarType(response), BooleanType()))), MurphiVarDecl('request_sent', ArrayType(VarType(node), ArrayType(VarType(request), BooleanType()))), MurphiVarDecl('response_sent', ArrayType(VarType(node), ArrayType(VarType(response), BooleanType()))), MurphiVarDecl('response_received', ArrayType(VarType(node), ArrayType(VarType(response), BooleanType())))), RulesetStartState((MurphiVarDecl('R', VarType(request)), MurphiVarDecl('P', VarType(response))), StartState('Init', [ForallCmd(MurphiVarDecl('N', VarType(node)), [AssignCmd(ArrayIndex(ArrayIndex(VarExpr('request_sent'), VarExpr('N')), VarExpr('R')), BooleanExpr(False)), AssignCmd(ArrayIndex(ArrayIndex(VarExpr('response_sent'), VarExpr('N')), VarExpr('P')), BooleanExpr(False)), AssignCmd(ArrayIndex(ArrayIndex(VarExpr('response_received'), VarExpr('N')), VarExpr('P')), BooleanExpr(False))])])), [MurphiRuleSet((MurphiVarDecl('n', VarType(node)), MurphiVarDecl('r', VarType(request))), MurphiRule('new_request', BooleanExpr(True), [AssignCmd(ArrayIndex(ArrayIndex(VarExpr('request_sent'), VarExpr('n')), VarExpr('r')), BooleanExpr(True))])), MurphiRuleSet((MurphiVarDecl('n', VarType(node)), MurphiVarDecl('r', VarType(request)), MurphiVarDecl('p', VarType(response))), MurphiRule('respond', OpExpr(&, request_sent[n][r] = true, match[r][p] = true), [AssignCmd(ArrayIndex(ArrayIndex(VarExpr('response_sent'), VarExpr('n')), VarExpr('p')), BooleanExpr(True))])), MurphiRuleSet((MurphiVarDecl('n', VarType(node)), MurphiVarDecl('p', VarType(response))), MurphiRule('receive_response', OpExpr(=, response_sent[n][p], true), [AssignCmd(ArrayIndex(ArrayIndex(VarExpr('response_received'), VarExpr('n')), VarExpr('p')), BooleanExpr(